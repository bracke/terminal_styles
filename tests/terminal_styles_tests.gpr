with "config/terminal_styles_tests_config.gpr";
project Terminal_Styles_Tests is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Terminal_Styles_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Terminal_Styles_Tests_Config.Ada_Compiler_Switches &
          ("-gnat2022", "-gnatyM120", "-gnata", "-gnatW8", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Terminal_Styles_Tests;
