with "../../project_tools/project_tools.gpr";

project Terminal_Styles_Check_All is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_all.adb", "check_all_selftest.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatW8", "-gnatwa");
   end Compiler;
end Terminal_Styles_Check_All;
