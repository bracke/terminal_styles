with "config/terminal_styles_config.gpr";
project Terminal_Styles is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Terminal_Styles_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";
   for Library_Name use "terminal_styles";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        Terminal_Styles_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Terminal_Styles;
