with "config/check_terminal_styles_config.gpr";
project Check_Terminal_Styles is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Terminal_Styles_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_terminal_styles.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Terminal_Styles_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Check_Terminal_Styles;
